<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- ViewModel の internal メンバ（StreamRecord など）をテストから検証するため -->
    <InternalsVisibleTo Include="InfTimestamper.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InfTimestamper.Core\InfTimestamper.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.8" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <StartupObject>InfTimestamper.Program</StartupObject>
    <!-- single-file publish 時にバンドルを圧縮する（165MB → 73MB）。
         初回起動時の展開が少し遅くなるが、配布サイズの削減を優先する -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    リリース時に更新する。GitHub Releases のタグは v{Version} 形式（VersionComparer が v を許容）。
    α 版は 1.2.0-alpha.1 のように SemVer のプレリリース表記にする（AssemblyVersion / FileVersion は数値のみ）。
    <Version> は AssemblyInformationalVersion に入り、SemanticVersion.FromAssembly が実行時に読む。
  -->
  <PropertyGroup>
    <Version>1.2.0-alpha.1</Version>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.0</FileVersion>
    <Product>INF-TIMESTAMPER</Product>
    <AssemblyTitle>INF-TIMESTAMPER</AssemblyTitle>
    <Description>音楽ゲーム配信の YouTube アーカイブ向けタイムスタンプ自動生成ツール</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- ウィンドウのアイコン。exe のアイコン（ApplicationIcon）と同じファイルを埋め込む -->
    <Resource Include="Assets\icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- 既定の ApplicationDefinition を解除し、App.xaml を Page として扱う。
         独自 Main で Velopack をブートストラップするための WPF 統合パターン -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>


</Project>

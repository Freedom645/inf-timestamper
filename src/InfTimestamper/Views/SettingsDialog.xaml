<Window x:Class="InfTimestamper.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:InfTimestamper.ViewModels.Settings"
        xmlns:conv="clr-namespace:InfTimestamper.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsDialogViewModel}"
        Title="設定"
        Icon="/Assets/icon.ico"
        Width="600" MinWidth="520"
        Height="640" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <conv:BoolToBrushConverter x:Key="ValidityToBrush" />
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <!-- 基本設定 -->
            <TabItem Header="基本設定">
                <StackPanel Margin="12">
                    <CheckBox Content="起動時の自動アップデートチェック"
                              IsChecked="{Binding General.AutoUpdateCheck}"
                              Margin="0,0,0,12" />

                    <TextBlock Text="バックアップ保存先" FontWeight="Bold" Margin="0,0,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding General.BackupDirectory, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{Binding General.IsBackupDirectoryValid, Converter={StaticResource ValidityToBrush}}"
                                 ToolTip="書込できるフォルダを指定してください（存在しない場合は保存時に作成します）"
                                 Padding="4" />
                        <Button Grid.Column="1" Content="参照..." Width="80" Margin="6,0,0,0"
                                Command="{Binding General.BrowseBackupDirectoryCommand}" />
                    </Grid>

                    <CheckBox Content="リセット時に確認ダイアログを表示"
                              IsChecked="{Binding General.ConfirmOnReset}"
                              Margin="0,12,0,4" />
                    <CheckBox Content="アプリ終了時に確認ダイアログを表示（記録中または未保存の編集時）"
                              IsChecked="{Binding General.ConfirmOnExit}" />

                    <CheckBox x:Name="IncludeStreamStartRowCheckBox"
                              Content="タイムスタンプの先頭に配信開始行（00:00:00）を入れる"
                              IsChecked="{Binding General.IncludeStreamStartRow}"
                              Margin="0,12,0,4" />
                    <Grid Margin="20,0,0,0"
                          IsEnabled="{Binding IsChecked, ElementName=IncludeStreamStartRowCheckBox}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="見出し文言" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding General.StreamStartRowLabel, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="4" />
                    </Grid>
                    <TextBlock Text="YouTube のチャプタ機能は先頭が 0 秒のチャプタであることを要求します。"
                               Foreground="Gray" TextWrapping="Wrap" Margin="20,4,0,0" />
                </StackPanel>
            </TabItem>

            <!-- 配信ソフト連携 -->
            <TabItem Header="配信ソフト連携">
                <StackPanel Margin="12">
                    <TextBlock Text="OBS 接続情報" FontWeight="Bold" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="ホスト" VerticalAlignment="Center" />
                        <TextBox  Grid.Row="0" Grid.Column="1"
                                  Text="{Binding Obs.Host, UpdateSourceTrigger=PropertyChanged}"
                                  Background="{Binding Obs.IsHostValid, Converter={StaticResource ValidityToBrush}}"
                                  ToolTip="IPv4 アドレス（例: 192.168.1.10）または localhost"
                                  Padding="4" Margin="0,2" />
                        <CheckBox Grid.Row="0" Grid.Column="2" Content="ローカルホスト"
                                  IsChecked="{Binding Obs.IsLocalhost}" VerticalAlignment="Center" Margin="8,0,0,0" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="ポート" VerticalAlignment="Center" />
                        <TextBox  Grid.Row="1" Grid.Column="1"
                                  Text="{Binding Obs.Port, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,2" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="パスワード" VerticalAlignment="Center" />
                        <PasswordBox Grid.Row="2" Grid.Column="1" x:Name="ObsPasswordBox" Padding="4" Margin="0,2" />
                    </Grid>
                    <Button Content="接続テスト" Width="120" HorizontalAlignment="Left"
                            Command="{Binding Obs.TestConnectionCommand}" />
                </StackPanel>
            </TabItem>

            <!-- YouTube 連携 -->
            <TabItem Header="YouTube 連携">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <CheckBox x:Name="YouTubeEnabledCheckBox"
                                  Content="ライブ配信の概要欄をタイムスタンプで自動更新する"
                                  IsChecked="{Binding YouTube.Enabled}"
                                  Margin="0,0,0,4" />
                        <TextBlock Text="記録中、配信開始時間とほぼ同時刻（前後 10 分以内）に始まった自分のライブ配信を探し、その概要欄の末尾にタイムスタンプを書き込みます。配信中のライブだけが対象です。"
                                   Foreground="Gray" TextWrapping="Wrap" Margin="20,0,0,12" />

                        <TextBlock Text="アカウント" FontWeight="Bold" Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="クライアント ID" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Text="{Binding YouTube.ClientId, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding YouTube.CanEditCredentials}"
                                     Padding="4" Margin="0,2" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="クライアント シークレット" VerticalAlignment="Center" />
                            <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="YouTubeClientSecretBox"
                                         IsEnabled="{Binding YouTube.CanEditCredentials}"
                                         Padding="4" Margin="0,2" />
                        </Grid>
                        <TextBlock Text="Google Cloud で作成した OAuth クライアント（種類「デスクトップ アプリ」）の値を入力します。作成手順は GitHub の docs/youtube.md を参照してください。"
                                   Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Button Content="ログイン..." Width="100" Margin="0,0,6,0"
                                    Command="{Binding YouTube.SignInCommand}" />
                            <Button Content="中断" Width="60" Margin="0,0,6,0"
                                    Command="{Binding YouTube.CancelSignInCommand}" />
                            <Button Content="ログアウト" Width="100"
                                    Command="{Binding YouTube.SignOutCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding YouTube.AccountStatusText}" Margin="0,0,0,12" />

                        <StackPanel IsEnabled="{Binding IsChecked, ElementName=YouTubeEnabledCheckBox}">
                            <TextBlock Text="見出し行" FontWeight="Bold" Margin="0,0,0,4" />
                            <TextBox Text="{Binding YouTube.DescriptionHeading, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{Binding YouTube.IsDescriptionHeadingValid, Converter={StaticResource ValidityToBrush}}"
                                     Padding="4" />
                            <TextBlock Text="概要欄のこの行から末尾までをタイムスタンプで置き換えます（無ければ末尾に追記します）。手書きの説明文はこの行より上に書いてください。"
                                       Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,12" />

                            <TextBlock Text="更新間隔（秒）" FontWeight="Bold" Margin="0,0,0,4" />
                            <TextBox Text="{Binding YouTube.UpdateIntervalSeconds, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{Binding YouTube.IsUpdateIntervalValid, Converter={StaticResource ValidityToBrush}}"
                                     Width="80" HorizontalAlignment="Left" Padding="4" />
                            <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0">
                                <Run Text="概要欄の書き換えは 1 回ごとに API の上限（1 日 10,000 ユニット）を 50 消費するため、この間隔で間引きます（最短" />
                                <Run Text="{Binding YouTube.MinUpdateIntervalSeconds, Mode=OneWay}" />
                                <Run Text="秒）。記録停止時は間隔を待たずに最終版を書き込みます。" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- INFINITAS -->
            <TabItem Header="INFINITAS">
                <StackPanel Margin="12">
                    <TextBlock Text="タイムスタンプフォーマット" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBox x:Name="InfinitasFormatTextBox"
                             Text="{Binding Infinitas.TimestampFormat, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas, Cascadia Mono"
                             Padding="4" Margin="0,0,0,4" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="識別子:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <ComboBox x:Name="InfinitasIdentifierCombo"
                                  ItemsSource="{Binding Infinitas.AvailableIdentifiers}"
                                  DisplayMemberPath="Display"
                                  SelectedValuePath="Key"
                                  SelectedValue="{Binding Infinitas.SelectedIdentifier}"
                                  Width="260" />
                        <Button Content="追加" Width="60" Margin="6,0,0,0"
                                Click="OnAddInfinitasIdentifierClick" />
                    </StackPanel>

                    <TextBlock Text="プレビュー" FontWeight="Bold" Margin="0,4,0,2" />
                    <Border BorderBrush="LightGray" BorderThickness="1" Padding="6">
                        <TextBlock Text="{Binding Infinitas.Preview}"
                                   FontFamily="Consolas, Cascadia Mono" />
                    </Border>

                    <TextBlock Text="Reflux 出力ディレクトリ" FontWeight="Bold" Margin="0,12,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding Infinitas.WatchDirectory, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="4" />
                        <Button Grid.Column="1" Content="参照..." Width="80" Margin="6,0,0,0"
                                Command="{Binding Infinitas.BrowseWatchDirectoryCommand}" />
                    </Grid>
                    <TextBlock Text="Reflux が playstate.txt / latest.json を出力するフォルダを指定します。"
                               Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </TabItem>

            <!-- pop'n music -->
            <TabItem Header="pop'n music">
                <StackPanel Margin="12">
                    <TextBlock Text="タイムスタンプフォーマット" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBox x:Name="PopnFormatTextBox"
                             Text="{Binding Popn.TimestampFormat, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas, Cascadia Mono"
                             Padding="4" Margin="0,0,0,4" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="識別子:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <ComboBox x:Name="PopnIdentifierCombo"
                                  ItemsSource="{Binding Popn.AvailableIdentifiers}"
                                  DisplayMemberPath="Display"
                                  SelectedValuePath="Key"
                                  SelectedValue="{Binding Popn.SelectedIdentifier}"
                                  Width="260" />
                        <Button Content="追加" Width="60" Margin="6,0,0,0"
                                Click="OnAddPopnIdentifierClick" />
                    </StackPanel>

                    <TextBlock Text="プレビュー" FontWeight="Bold" Margin="0,4,0,2" />
                    <Border BorderBrush="LightGray" BorderThickness="1" Padding="6">
                        <TextBlock Text="{Binding Popn.Preview}"
                                   FontFamily="Consolas, Cascadia Mono" />
                    </Border>

                    <TextBlock Text="popn-lively-tracker 出力ディレクトリ" FontWeight="Bold" Margin="0,12,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding Popn.WatchDirectory, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="4" />
                        <Button Grid.Column="1" Content="参照..." Width="80" Margin="6,0,0,0"
                                Command="{Binding Popn.BrowseWatchDirectoryCommand}" />
                    </Grid>
                    <TextBlock Text="popn-lively-tracker が state.txt / result.json を出力するフォルダを指定します。リザルトは画面表示から数秒遅れて記録されます。"
                               Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </TabItem>

            <!-- SOUND VOLTEX -->
            <TabItem Header="SOUND VOLTEX">
                <StackPanel Margin="12">
                    <TextBlock Text="タイムスタンプフォーマット" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBox x:Name="SdvxFormatTextBox"
                             Text="{Binding Sdvx.TimestampFormat, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas, Cascadia Mono"
                             Padding="4" Margin="0,0,0,4" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="識別子:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <ComboBox x:Name="SdvxIdentifierCombo"
                                  ItemsSource="{Binding Sdvx.AvailableIdentifiers}"
                                  DisplayMemberPath="Display"
                                  SelectedValuePath="Key"
                                  SelectedValue="{Binding Sdvx.SelectedIdentifier}"
                                  Width="260" />
                        <Button Content="追加" Width="60" Margin="6,0,0,0"
                                Click="OnAddSdvxIdentifierClick" />
                    </StackPanel>

                    <TextBlock Text="プレビュー" FontWeight="Bold" Margin="0,4,0,2" />
                    <Border BorderBrush="LightGray" BorderThickness="1" Padding="6">
                        <TextBlock Text="{Binding Sdvx.Preview}"
                                   FontFamily="Consolas, Cascadia Mono" />
                    </Border>

                    <TextBlock Text="SDVX Helper の接続先" FontWeight="Bold" Margin="0,12,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding Sdvx.HelperHost, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{Binding Sdvx.IsHelperHostValid, Converter={StaticResource ValidityToBrush}}"
                                 ToolTip="IPv4 アドレスまたは localhost"
                                 Padding="4" />
                        <TextBlock Grid.Column="1" Text=":" VerticalAlignment="Center" Margin="4,0" />
                        <TextBox Grid.Column="2" Width="80"
                                 Text="{Binding Sdvx.HelperPort, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{Binding Sdvx.IsHelperPortValid, Converter={StaticResource ValidityToBrush}}"
                                 ToolTip="SDVX Helper の設定にある「WebSocketデータ配信ポート」と同じ値を指定してください"
                                 Padding="4" />
                    </Grid>
                    <CheckBox Content="ローカルホスト（127.0.0.1）"
                              IsChecked="{Binding Sdvx.IsLocalhost}"
                              Margin="0,6,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="接続先: " Foreground="Gray" />
                        <TextBlock Text="{Binding Sdvx.Endpoint}" Foreground="Gray" />
                    </StackPanel>
                    <TextBlock Text="SDVX Helper のデータ配信サーバは localhost にしか待ち受けないため、通常はこのPCのままにしてください（別PCのIPを指定しても接続できません）。リザルトが SDVX Helper に登録された時点で成績を埋めます。"
                               Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0" />

                    <TextBlock Text="SDVX Helper のフォルダ（推奨）" FontWeight="Bold" Margin="0,12,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding Sdvx.WatchDirectory, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="sdvx_helper.exe があるフォルダ（直下に log フォルダが作られます）"
                                 Padding="4" />
                        <Button Grid.Column="1" Content="参照..." Width="80" Margin="6,0,0,0"
                                Command="{Binding Sdvx.BrowseWatchDirectoryCommand}" />
                    </Grid>
                    <TextBlock Text="指定すると log\sdvx_helper.log の画面遷移を監視し、プレイ画面に入った時刻をプレイ開始として記録します。リザルト画面からのリトライや、曲決定画面を取りこぼした場合もこれで拾えます。未指定の場合は曲決定画面の検知だけになり、リトライは記録されません。"
                               Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="確定" Command="{Binding ConfirmCommand}" IsDefault="True"
                    Width="80" Height="28" Margin="0,0,8,0" />
            <Button Content="閉じる" Command="{Binding CancelCommand}" IsCancel="True"
                    Width="80" Height="28" />
        </StackPanel>
    </Grid>
</Window>

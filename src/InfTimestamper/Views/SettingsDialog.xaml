<Window x:Class="InfTimestamper.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:InfTimestamper.ViewModels.Settings"
        xmlns:conv="clr-namespace:InfTimestamper.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsDialogViewModel}"
        Title="設定"
        Icon="/Assets/icon.ico"
        Width="600" MinWidth="520"
        Height="520" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <conv:BoolToBrushConverter x:Key="ValidityToBrush" />
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <!-- 基本設定 -->
            <TabItem Header="基本設定">
                <StackPanel Margin="12">
                    <CheckBox Content="起動時の自動アップデートチェック"
                              IsChecked="{Binding General.AutoUpdateCheck}"
                              Margin="0,0,0,12" />

                    <TextBlock Text="バックアップ保存先" FontWeight="Bold" Margin="0,0,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding General.BackupDirectory, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{Binding General.IsBackupDirectoryValid, Converter={StaticResource ValidityToBrush}}"
                                 ToolTip="書込できるフォルダを指定してください（存在しない場合は保存時に作成します）"
                                 Padding="4" />
                        <Button Grid.Column="1" Content="参照..." Width="80" Margin="6,0,0,0"
                                Command="{Binding General.BrowseBackupDirectoryCommand}" />
                    </Grid>

                    <CheckBox Content="リセット時に確認ダイアログを表示"
                              IsChecked="{Binding General.ConfirmOnReset}"
                              Margin="0,12,0,4" />
                    <CheckBox Content="アプリ終了時に確認ダイアログを表示（記録中または未保存の編集時）"
                              IsChecked="{Binding General.ConfirmOnExit}" />

                    <CheckBox x:Name="IncludeStreamStartRowCheckBox"
                              Content="タイムスタンプの先頭に配信開始行（00:00:00）を入れる"
                              IsChecked="{Binding General.IncludeStreamStartRow}"
                              Margin="0,12,0,4" />
                    <Grid Margin="20,0,0,0"
                          IsEnabled="{Binding IsChecked, ElementName=IncludeStreamStartRowCheckBox}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="見出し文言" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding General.StreamStartRowLabel, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="4" />
                    </Grid>
                    <TextBlock Text="YouTube のチャプタ機能は先頭が 0 秒のチャプタであることを要求します。"
                               Foreground="Gray" TextWrapping="Wrap" Margin="20,4,0,0" />
                </StackPanel>
            </TabItem>

            <!-- 配信ソフト連携 -->
            <TabItem Header="配信ソフト連携">
                <StackPanel Margin="12">
                    <TextBlock Text="OBS 接続情報" FontWeight="Bold" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="ホスト" VerticalAlignment="Center" />
                        <TextBox  Grid.Row="0" Grid.Column="1"
                                  Text="{Binding Obs.Host, UpdateSourceTrigger=PropertyChanged}"
                                  Background="{Binding Obs.IsHostValid, Converter={StaticResource ValidityToBrush}}"
                                  ToolTip="IPv4 アドレス（例: 192.168.1.10）または localhost"
                                  Padding="4" Margin="0,2" />
                        <CheckBox Grid.Row="0" Grid.Column="2" Content="ローカルホスト"
                                  IsChecked="{Binding Obs.IsLocalhost}" VerticalAlignment="Center" Margin="8,0,0,0" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="ポート" VerticalAlignment="Center" />
                        <TextBox  Grid.Row="1" Grid.Column="1"
                                  Text="{Binding Obs.Port, UpdateSourceTrigger=PropertyChanged}" Padding="4" Margin="0,2" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="パスワード" VerticalAlignment="Center" />
                        <PasswordBox Grid.Row="2" Grid.Column="1" x:Name="ObsPasswordBox" Padding="4" Margin="0,2" />
                    </Grid>
                    <Button Content="接続テスト" Width="120" HorizontalAlignment="Left"
                            Command="{Binding Obs.TestConnectionCommand}" />
                </StackPanel>
            </TabItem>

            <!-- INFINITAS -->
            <TabItem Header="INFINITAS">
                <StackPanel Margin="12">
                    <TextBlock Text="タイムスタンプフォーマット" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBox x:Name="InfinitasFormatTextBox"
                             Text="{Binding Infinitas.TimestampFormat, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas, Cascadia Mono"
                             Padding="4" Margin="0,0,0,4" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="識別子:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <ComboBox x:Name="InfinitasIdentifierCombo"
                                  ItemsSource="{Binding Infinitas.AvailableIdentifiers}"
                                  SelectedItem="{Binding Infinitas.SelectedIdentifier}"
                                  Width="160" />
                        <Button Content="追加" Width="60" Margin="6,0,0,0"
                                Click="OnAddInfinitasIdentifierClick" />
                    </StackPanel>

                    <TextBlock Text="プレビュー" FontWeight="Bold" Margin="0,4,0,2" />
                    <Border BorderBrush="LightGray" BorderThickness="1" Padding="6">
                        <TextBlock Text="{Binding Infinitas.Preview}"
                                   FontFamily="Consolas, Cascadia Mono" />
                    </Border>

                    <TextBlock Text="Reflux 出力ディレクトリ" FontWeight="Bold" Margin="0,12,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding Infinitas.WatchDirectory, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="4" />
                        <Button Grid.Column="1" Content="参照..." Width="80" Margin="6,0,0,0"
                                Command="{Binding Infinitas.BrowseWatchDirectoryCommand}" />
                    </Grid>
                    <TextBlock Text="Reflux が playstate.txt / latest.json を出力するフォルダを指定します。"
                               Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </TabItem>

            <!-- pop'n music -->
            <TabItem Header="pop'n music">
                <StackPanel Margin="12">
                    <TextBlock Text="タイムスタンプフォーマット" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBox x:Name="PopnFormatTextBox"
                             Text="{Binding Popn.TimestampFormat, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas, Cascadia Mono"
                             Padding="4" Margin="0,0,0,4" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="識別子:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <ComboBox x:Name="PopnIdentifierCombo"
                                  ItemsSource="{Binding Popn.AvailableIdentifiers}"
                                  SelectedItem="{Binding Popn.SelectedIdentifier}"
                                  Width="160" />
                        <Button Content="追加" Width="60" Margin="6,0,0,0"
                                Click="OnAddPopnIdentifierClick" />
                    </StackPanel>

                    <TextBlock Text="プレビュー" FontWeight="Bold" Margin="0,4,0,2" />
                    <Border BorderBrush="LightGray" BorderThickness="1" Padding="6">
                        <TextBlock Text="{Binding Popn.Preview}"
                                   FontFamily="Consolas, Cascadia Mono" />
                    </Border>

                    <TextBlock Text="popn-lively-tracker 出力ディレクトリ" FontWeight="Bold" Margin="0,12,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding Popn.WatchDirectory, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="4" />
                        <Button Grid.Column="1" Content="参照..." Width="80" Margin="6,0,0,0"
                                Command="{Binding Popn.BrowseWatchDirectoryCommand}" />
                    </Grid>
                    <TextBlock Text="popn-lively-tracker が state.txt / result.json を出力するフォルダを指定します。リザルトは画面表示から数秒遅れて記録されます。"
                               Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </TabItem>

            <!-- SOUND VOLTEX -->
            <TabItem Header="SOUND VOLTEX">
                <StackPanel Margin="12">
                    <TextBlock Text="タイムスタンプフォーマット" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBox x:Name="SdvxFormatTextBox"
                             Text="{Binding Sdvx.TimestampFormat, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas, Cascadia Mono"
                             Padding="4" Margin="0,0,0,4" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="識別子:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <ComboBox x:Name="SdvxIdentifierCombo"
                                  ItemsSource="{Binding Sdvx.AvailableIdentifiers}"
                                  SelectedItem="{Binding Sdvx.SelectedIdentifier}"
                                  Width="160" />
                        <Button Content="追加" Width="60" Margin="6,0,0,0"
                                Click="OnAddSdvxIdentifierClick" />
                    </StackPanel>

                    <TextBlock Text="プレビュー" FontWeight="Bold" Margin="0,4,0,2" />
                    <Border BorderBrush="LightGray" BorderThickness="1" Padding="6">
                        <TextBlock Text="{Binding Sdvx.Preview}"
                                   FontFamily="Consolas, Cascadia Mono" />
                    </Border>

                    <TextBlock Text="SDVX Helper のデータ配信ポート" FontWeight="Bold" Margin="0,12,0,4" />
                    <TextBox Width="100" HorizontalAlignment="Left"
                             Text="{Binding Sdvx.HelperPort, UpdateSourceTrigger=PropertyChanged}"
                             Background="{Binding Sdvx.IsHelperPortValid, Converter={StaticResource ValidityToBrush}}"
                             ToolTip="SDVX Helper の設定にある「WebSocketデータ配信ポート」と同じ値を指定してください"
                             Padding="4" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="接続先: " Foreground="Gray" />
                        <TextBlock Text="{Binding Sdvx.WatchTarget}" Foreground="Gray" />
                    </StackPanel>
                    <TextBlock Text="SDVX Helper が同じ PC で動いている必要があります。曲決定時にプレイ開始を記録し、リザルトが SDVX Helper に登録された時点で成績を埋めます。"
                               Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="確定" Command="{Binding ConfirmCommand}" IsDefault="True"
                    Width="80" Height="28" Margin="0,0,8,0" />
            <Button Content="閉じる" Command="{Binding CancelCommand}" IsCancel="True"
                    Width="80" Height="28" />
        </StackPanel>
    </Grid>
</Window>
